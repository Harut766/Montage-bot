# Токен бота от @BotFather
BOT_TOKEN=

# Для Local Bot API Server (файлы до 2 ГБ). Берутся на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram ID, которым разрешён доступ к боту (через запятую)
ALLOWED_USERS=878915895,6049619073

# Модель Whisper: small (быстро) / medium (баланс) / large-v3 (точнее, медленно)
WHISPER_MODEL=medium
# auto / cpu / cuda
WHISPER_DEVICE=auto

# Куки YouTube (формат Netscape) для ссылок, требующих входа. Положите файл в data/cookies.txt.
# Пусто/нет файла — скачивание без кук (для таких ссылок берите видео файлом).
COOKIES_FILE=/data/cookies.txt

# Анимированный баннер БУБА VPN. Положите файл в data/banner.mp4 (или .gif/.webm/.mov).
# Бот сам ставит его РОВНО по центру, не меньше 25% экрана, по таймингам правил.
BANNER_PATH=/data
