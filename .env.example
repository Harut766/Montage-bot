# Токен бота от @BotFather
BOT_TOKEN=

# Для Local Bot API Server (файлы до 2 ГБ). Берутся на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram ID, которым разрешён доступ к боту (через запятую)
ALLOWED_USERS=878915895,6049619073

# Webhook n8n, который выбирает интересные фрагменты через Gemini.
# Если n8n на сервере: https://ваш-n8n-домен/webhook/montage-segments
# Если n8n в Docker на этом же компьютере: http://host.docker.internal:5678/webhook/montage-segments
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/montage-segments
# Секрет для webhook (любая длинная случайная строка). Тот же ключ вписывается в n8n,
# в credential "Header Auth" узла Webhook: Name = X-Montage-Secret
N8N_SECRET=

# Модель Whisper: small (быстро) / medium (баланс) / large-v3 (точнее, медленно)
WHISPER_MODEL=medium
# auto / cpu / cuda
WHISPER_DEVICE=auto
